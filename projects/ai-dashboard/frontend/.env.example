# AI Dashboard Frontend - Environment Variables

# =============================================================================
# REQUIRED - Server-only control-plane configuration
# =============================================================================

# Browser HTTP Basic credentials. Keep the secret distinct from the backend token.
AI_DASHBOARD_BROWSER_USERNAME=admin
AI_DASHBOARD_BROWSER_SECRET=

# Backend credential added only by the authenticated same-origin proxy.
AI_DASHBOARD_ADMIN_TOKEN=
AI_DASHBOARD_BACKEND_URL=http://127.0.0.1:8000

# Production example (configure secrets in the deployment provider, never here):
# AI_DASHBOARD_BACKEND_URL=https://your-backend.railway.app
