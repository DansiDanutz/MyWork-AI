{
  "name": "NERVIX Agent Health Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "id": "trigger-1"
    },
    {
      "parameters": {
        "url": "={{.NERVIX_API_URL}}/api/health",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Check NERVIX API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        300
      ],
      "id": "http-1"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{.status}}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        300
      ],
      "id": "if-1"
    },
    {
      "parameters": {
        "chatId": "={{.DAN_CHAT_ID}}",
        "text": "=\u26a0\ufe0f NERVIX API DOWN at {{.toISO()}}\\nEndpoint: {{.NERVIX_API_URL}}/api/health\\nStatus: {{.status || \"unreachable\"}}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "name": "Alert Dan",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        850,
        400
      ],
      "id": "tg-1"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check NERVIX API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check NERVIX API": {
      "main": [
        [
          {
            "node": "Is Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Healthy?": {
      "main": [
        [],
        [
          {
            "node": "Alert Dan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "nervix"
    },
    {
      "name": "monitoring"
    },
    {
      "name": "ops"
    }
  ]
}